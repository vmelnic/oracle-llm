{
  "name": "llm-oracle",
  "version": "0.1.0",
  "private": true,
  "description": "Layered grounded oracle — deterministic code intelligence via MCP",
  "license": "MIT",
  "type": "module",
  "bin": {
    "oracle": "./bin/oracle.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "prompts/",
    ".env.example",
    "README.md",
    "CHANGELOG.md",
    "docs/",
    "examples/"
  ],
  "scripts": {
    "start": "node bin/oracle.js serve",
    "serve": "node bin/oracle.js serve",
    "serve:http": "node bin/oracle.js serve --transport http",
    "workspace:add": "node bin/oracle.js workspace add",
    "workspace:scan": "node bin/oracle.js workspace scan",
    "workspace:list": "node bin/oracle.js workspace list",
    "ingest": "node bin/oracle.js ingest",
    "manifest:show": "node bin/oracle.js manifest show",
    "manifest:draft": "node bin/oracle.js manifest draft",
    "manifest:edit": "node bin/oracle.js manifest edit",
    "manifest:path": "node bin/oracle.js manifest path",
    "patterns:list": "node bin/oracle.js patterns list",
    "gate": "node bin/oracle.js gate",
    "db:migrate": "node bin/oracle.js db migrate",
    "db:reset": "node bin/oracle.js db reset",
    "db:path": "node bin/oracle.js db path",
    "status": "node bin/oracle.js status",
    "hooks:install": "node bin/oracle.js hooks install",
    "hooks:uninstall": "node bin/oracle.js hooks uninstall",
    "hooks:reindex": "node bin/oracle.js hooks reindex",
    "benchmark": "node bin/oracle.js benchmark",
    "llm:download": "node bin/oracle.js llm download",
    "llm:start": "node bin/oracle.js llm start",
    "llm:status": "node bin/oracle.js llm status",
    "llm:stop": "node bin/oracle.js llm stop",
    "llm:bench": "node bin/oracle.js llm bench",
    "test": "node --test tests/**/*.test.js",
    "check:dead-code": "knip",
    "check": "npm run lint && npm test && npm run check:dead-code && npm audit --omit=dev --audit-level=high",
    "lint": "eslint .",
    "test:coverage": "node --test --experimental-test-coverage tests/**/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sengac/tree-sitter-dart": "^1.1.6",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "fast-glob": "^3.3.3",
    "js-yaml": "^5.5.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-vue": "^0.2.1"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.3",
    "tree-sitter": "$tree-sitter"
  },
  "engines": {
    "node": ">=20.3.0 <25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "knip": "^6.31.0"
  },
  "packageManager": "npm@11.15.0"
}
