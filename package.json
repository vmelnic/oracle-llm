{
  "name": "llm-oracle",
  "version": "0.1.0",
  "private": true,
  "description": "Layered grounded oracle — deterministic code intelligence via MCP",
  "type": "module",
  "bin": {
    "oracle": "./bin/oracle.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/oracle.js serve",
    "serve": "node bin/oracle.js serve",
    "serve:http": "node bin/oracle.js serve --transport http",
    "serve:sse": "node bin/oracle.js serve --transport sse",
    "workspace:add": "node bin/oracle.js workspace add",
    "workspace:scan": "node bin/oracle.js workspace scan",
    "workspace:list": "node bin/oracle.js workspace list",
    "ingest": "node bin/oracle.js ingest",
    "manifest:show": "node bin/oracle.js manifest show",
    "manifest:draft": "node bin/oracle.js manifest draft",
    "manifest:edit": "node bin/oracle.js manifest edit",
    "manifest:path": "node bin/oracle.js manifest path",
    "patterns:list": "node bin/oracle.js patterns list",
    "gate": "node bin/oracle.js gate",
    "db:migrate": "node bin/oracle.js db migrate",
    "db:reset": "node bin/oracle.js db reset",
    "db:path": "node bin/oracle.js db path",
    "status": "node bin/oracle.js status",
    "hooks:install": "node bin/oracle.js hooks install",
    "hooks:uninstall": "node bin/oracle.js hooks uninstall",
    "hooks:reindex": "node bin/oracle.js hooks reindex",
    "benchmark": "node bin/oracle.js benchmark",
    "model:serve": "./scripts/serve-model.sh",
    "test": "node --test tests/**/*.test.js",
    "check:dead-code": "knip",
    "check": "npm test && npm run check:dead-code && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sengac/tree-sitter-dart": "^1.1.6",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "js-yaml": "^4.3.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-vue": "^0.2.1"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.3",
    "tree-sitter": "$tree-sitter"
  },
  "engines": {
    "node": ">=20.0.0 <25"
  },
  "devDependencies": {
    "knip": "^6.31.0"
  },
  "packageManager": "npm@11.15.0"
}
