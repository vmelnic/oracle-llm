# llm-oracle environment configuration
# Copy this file to .env and adjust values as needed.

# Data directory (default: ~/.oracle)
ORACLE_HOME=~/.oracle

# MCP server defaults
ORACLE_MCP_PORT=3000
ORACLE_MCP_HOST=127.0.0.1
ORACLE_MCP_IDLE_TIMEOUT_MINUTES=0
# Required for non-loopback HTTP binds; must contain at least 32 bytes
# ORACLE_MCP_AUTH_TOKEN=replace-with-a-long-random-token
# HTTP admin tools are disabled by default. Enabling them also requires an allowlist.
ORACLE_MCP_ADMIN_ENABLED=false
# ORACLE_ALLOWED_ROOTS=/absolute/project/root,/another/allowed/root
# Required for non-loopback binds (comma-separated Host header allowlist)
# ORACLE_MCP_ALLOWED_HOSTS=oracle.internal.example:3000
# ORACLE_MCP_ALLOWED_ORIGINS=https://trusted-client.example
ORACLE_MCP_MAX_BODY_BYTES=1048576
ORACLE_MCP_RATE_LIMIT_PER_MINUTE=120
ORACLE_MCP_MAX_SESSIONS=100
ORACLE_MCP_SESSION_IDLE_MINUTES=30
ORACLE_MCP_MAX_CONNECTIONS=200
ORACLE_MCP_HEADERS_TIMEOUT_MS=10000
ORACLE_MCP_REQUEST_TIMEOUT_MS=120000
ORACLE_MCP_KEEPALIVE_TIMEOUT_MS=5000

# L2 BM25 search tuning
ORACLE_BM25_K1=1.2
ORACLE_BM25_B=0.75

# L2 semantic embeddings (bridges "register" → "auth" gaps that BM25 cannot)
# Set to true to enable, false to disable (default: false, BM25-only)
# Can be overridden per-ingest with --embeddings / --no-embeddings
ORACLE_EMBEDDINGS=false

# Embedding model — required when ORACLE_EMBEDDINGS=true
# Local (ONNX via @huggingface/transformers): just set the model name
ORACLE_EMBED_MODEL=jinaai/jina-embeddings-v2-base-code
#
# Unload idle embedding model after N seconds to free ~1GB RAM (0 = never unload)
ORACLE_EMBED_UNLOAD_TIMEOUT=300
#
# Max nodes to embed per subproject (0 = embed all). Embeddings are cached
# by content hash in vectors.json, so re-ingests only embed changed nodes.
# ORACLE_EMBED_MAX_NODES=0
#
# Remote API (OpenAI-compatible): set model + API URL + key
# ORACLE_EMBED_MODEL=voyage-code-3
# ORACLE_EMBED_API_URL=https://api.voyageai.com/v1/embeddings
# ORACLE_EMBED_API_KEY=your-api-key
# ORACLE_EMBED_DIMENSIONS=1024

# Graph traversal depth for consumers/impact queries
ORACLE_MAX_DEPTH=5

# L3 Neural synthesis (OpenAI-compatible API)
# Enable L3 to augment open-ended tools (context, where_would, conventions_for)
# with natural-language synthesis from a local model. L1 facts are injected into
# the model prompt — no fine-tuning required.
ORACLE_L3_ENABLED=false
#
# Ollama (recommended — easiest setup):
# ORACLE_L3_BASE_URL=http://localhost:11434/v1
# ORACLE_L3_MODEL=qwen3.5:9b
#
# mlx-lm / vllm (via scripts/serve-model.sh):
# ORACLE_L3_BASE_URL=http://localhost:8321/v1
# ORACLE_L3_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct
#
# ORACLE_L3_API_KEY=

# Output format: 'toon' (token-optimized, ~35% fewer tokens) or 'json'
# TOON uses tabular format for arrays, reducing key repetition.
# Default: toon — LLMs parse it with equal or better accuracy.
ORACLE_OUTPUT_FORMAT=toon

# MCP cache size (number of entries)
# ORACLE_MCP_CACHE_SIZE=128

# Emit-gate LSP timeout (ms)
# ORACLE_LSP_TIMEOUT_MS=10000

# Resource safety limits
ORACLE_MAX_FILES=100000
ORACLE_MAX_FILE_BYTES=5242880
ORACLE_READ_EXACT_MAX_LINES=2000
ORACLE_READ_EXACT_MAX_BYTES=1048576
ORACLE_GATE_MAX_FILES=500
ORACLE_GATE_MAX_CODE_BYTES=5242880
ORACLE_GATE_MAX_TOTAL_CODE_BYTES=20971520
ORACLE_GATE_MAX_SHADOW_FILES=100000
ORACLE_GATE_MAX_SHADOW_BYTES=1073741824
ORACLE_GATE_USE_SHADOW=true
