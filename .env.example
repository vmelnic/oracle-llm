# llm-oracle environment configuration
# Copy this file to .env and adjust values as needed.

# Data directory (default: ~/.oracle)
ORACLE_HOME=~/.oracle

# MCP server defaults
ORACLE_MCP_PORT=3000
ORACLE_MCP_HOST=127.0.0.1
ORACLE_MCP_IDLE_TIMEOUT_MINUTES=0
# Required for non-loopback HTTP binds; must contain at least 32 bytes
# ORACLE_MCP_AUTH_TOKEN=replace-with-a-long-random-token
# HTTP admin tools are disabled by default. Enabling them also requires an allowlist.
ORACLE_MCP_ADMIN_ENABLED=false
# Restricts admin tools and, over HTTP, which workspaces query tools may read
# ORACLE_ALLOWED_ROOTS=/absolute/project/root,/another/allowed/root
# oracle.gate copies client-supplied code into a shadow tree and runs the
# project's type-checker and tests on it, i.e. it executes code the client
# controls. Over HTTP it stays off unless admin tools AND this flag are enabled.
ORACLE_MCP_GATE_ENABLED=false
# Required for non-loopback binds (comma-separated Host header allowlist)
# ORACLE_MCP_ALLOWED_HOSTS=oracle.internal.example:3000
# ORACLE_MCP_ALLOWED_ORIGINS=https://trusted-client.example
ORACLE_MCP_MAX_BODY_BYTES=1048576
# Keyed by the client socket address. Behind a reverse proxy every client shares
# the proxy's address (one bucket), so rate-limit at the proxy instead.
ORACLE_MCP_RATE_LIMIT_PER_MINUTE=120
ORACLE_MCP_MAX_SESSIONS=100
ORACLE_MCP_SESSION_IDLE_MINUTES=30
ORACLE_MCP_MAX_CONNECTIONS=200
ORACLE_MCP_HEADERS_TIMEOUT_MS=10000
ORACLE_MCP_REQUEST_TIMEOUT_MS=120000
ORACLE_MCP_KEEPALIVE_TIMEOUT_MS=5000

# L2 BM25 search tuning
ORACLE_BM25_K1=1.2
ORACLE_BM25_B=0.75

# L2 semantic embeddings (bridges "register" → "auth" gaps that BM25 cannot)
# Set to true to enable, false to disable (default: false, BM25-only)
# Can be overridden per-ingest with --embeddings / --no-embeddings
ORACLE_EMBEDDINGS=false

# Embedding model — required when ORACLE_EMBEDDINGS=true
# Local (ONNX via @huggingface/transformers): just set the model name
ORACLE_EMBED_MODEL=jinaai/jina-embeddings-v2-base-code
#
# Unload idle embedding model after N seconds to free ~1GB RAM (0 = never unload)
ORACLE_EMBED_UNLOAD_TIMEOUT=300
#
# Max nodes to embed per subproject (0 = embed all). Embeddings are cached
# by content hash in the L2 index (ast_embed_index/vectors.<gen>.bin), so
# re-ingests only embed changed nodes.
# ORACLE_EMBED_MAX_NODES=0
#
# Remote API (OpenAI-compatible): set model + API URL + key
# ORACLE_EMBED_MODEL=voyage-code-3
# ORACLE_EMBED_API_URL=https://api.voyageai.com/v1/embeddings
# ORACLE_EMBED_API_KEY=your-api-key
# ORACLE_EMBED_DIMENSIONS=1024

# Graph traversal depth for consumers/impact queries
ORACLE_MAX_DEPTH=5
# Max nodes a single consumers/impact traversal returns
ORACLE_MAX_TRAVERSAL_RESULTS=1000

# ── L3: natural-language synthesis (optional) ─────────────────────────────
# Adds a short, cited answer (_l3_synthesis) to oracle.context, where_would and
# conventions_for. The model only sees verified L1/L2 facts and cites them by
# number; an answer citing anything else is dropped and the plain L1/L2 result
# is returned. Works with ANY OpenAI-compatible /v1/chat/completions backend:
# the bundled llama.cpp server (below), Ollama, vLLM, LM Studio, OpenRouter,
# OpenAI ... Prompts live in prompts/l3/*.txt.
ORACLE_L3_ENABLED=false
# Endpoint and model. Local llama.cpp (oracle llm start):
ORACLE_L3_BASE_URL=http://127.0.0.1:8321/v1
ORACLE_L3_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M
# Other backends, e.g.:
#   Ollama:     ORACLE_L3_BASE_URL=http://127.0.0.1:11434/v1   ORACLE_L3_MODEL=qwen3:4b-instruct
#   OpenRouter: ORACLE_L3_BASE_URL=https://openrouter.ai/api/v1 ORACLE_L3_MODEL=qwen/qwen3-4b
# Bearer token, if the backend needs one (must match ORACLE_LLM_API_KEY for the local server)
# ORACLE_L3_API_KEY=
# Deadline for one synthesis call, retries included (ms)
ORACLE_L3_TIMEOUT_MS=180000
# Retries on 429/5xx/connection reset (0 disables)
ORACLE_L3_RETRIES=1
# Answer length cap. With the local server the answer also stops when prompt
# plus answer fill ORACLE_LLM_CTX_SIZE; an answer cut before its evidence line
# is rejected as truncated.
ORACLE_L3_MAX_TOKENS=32768
ORACLE_L3_TEMPERATURE=0.2
# Prompt budget for facts; facts beyond it are summarized in one line. Each 1K
# tokens adds a few seconds of prompt processing on small local machines.
ORACLE_L3_CONTEXT_TOKENS=1500
# Thinking models: none | minimal | low | medium | high, sent as reasoning_effort
# (Ollama, OpenAI). Leave empty for backends that don't support it.
# ORACLE_L3_REASONING_EFFORT=none
# Extra JSON merged into every request body / extra HTTP headers, for
# backend-specific options, e.g. vLLM: {"chat_template_kwargs": {"enable_thinking": false}}
# ORACLE_L3_EXTRA_BODY={}
# ORACLE_L3_EXTRA_HEADERS={"HTTP-Referer": "https://example.com"}
# claims (default): the model returns JSON sentences with their claims, each
# checked against the facts and graph relations; unsupported sentences are
# dropped. text: prose plus an evidence line, checked only for citations and
# paths (for backends without JSON output).
# ORACLE_L3_OUTPUT=claims
# Directory with the prompt templates (default: prompts/l3 in this repo)
# ORACLE_L3_PROMPTS_DIR=

# ── Local model server: llama.cpp (oracle llm download|start|status|stop) ──
# Oracle never installs software. Install llama.cpp yourself first
# (macOS: brew install llama.cpp); see README "Local model (llama.cpp)".
# Path or name of the llama-server binary
ORACLE_LLM_BIN=llama-server
# GGUF to download from Hugging Face (verified against the published SHA-256)
ORACLE_LLM_HF_REPO=unsloth/Qwen3-4B-Instruct-2507-GGUF
ORACLE_LLM_HF_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# Lower-memory alternative (~0.5 GB less RAM, weaker answers):
#   ORACLE_LLM_HF_REPO=mistralai/Ministral-3-3B-Instruct-2512-GGUF
#   ORACLE_LLM_HF_FILE=Ministral-3-3B-Instruct-2512-Q4_K_M.gguf
#   (and ORACLE_L3_MODEL=Ministral-3-3B-Instruct-2512-Q4_K_M)
# ORACLE_LLM_HF_REVISION=main
# Token for gated or private repos
# ORACLE_LLM_HF_TOKEN=
# Enforce a specific SHA-256 instead of the one Hugging Face publishes
# ORACLE_LLM_SHA256=
# Where models are stored (default: $ORACLE_HOME/models), or a full path to a GGUF
# ORACLE_LLM_MODELS_DIR=~/.oracle/models
# ORACLE_LLM_MODEL_PATH=
# Bind address; a non-loopback host requires ORACLE_LLM_API_KEY
ORACLE_LLM_HOST=127.0.0.1
ORACLE_LLM_PORT=8321
# Model name the server reports (default: the GGUF file name without .gguf)
# ORACLE_LLM_ALIAS=
# ORACLE_LLM_API_KEY=
# Context window, shared by the parallel slots. It must hold the prompt
# (~0.3-2K tokens) plus the answer (ORACLE_L3_MAX_TOKENS). Qwen3-4B + q8_0 KV
# cache: ~4.8 GB resident at 32768, ~3.1 GB at 4096.
ORACLE_LLM_CTX_SIZE=32768
# KV cache precision (f16, q8_0, q4_0 ...): q8_0 halves cache memory
ORACLE_LLM_KV_CACHE_TYPE=q8_0
# Prompt cache in RAM, MiB (llama.cpp defaults to 8192; 0 disables)
ORACLE_LLM_CACHE_RAM_MIB=256
# Layers on the GPU: a number, auto or all
ORACLE_LLM_GPU_LAYERS=all
# CPU threads (0 or empty = llama.cpp default) and parallel request slots
# ORACLE_LLM_THREADS=
ORACLE_LLM_PARALLEL=1
# Thinking budget for hybrid models: 0 disables thinking, -1 unlimited
ORACLE_LLM_REASONING_BUDGET=0
# How long `oracle llm start` waits for the server to become ready (ms)
ORACLE_LLM_START_TIMEOUT_MS=120000
# Extra llama-server flags, space-separated
# ORACLE_LLM_EXTRA_ARGS=

# Output format: 'toon' (token-optimized, ~35% fewer tokens) or 'json'
# TOON uses tabular format for arrays, reducing key repetition.
# Default: toon — LLMs parse it with equal or better accuracy.
ORACLE_OUTPUT_FORMAT=toon

# MCP cache size (number of entries)
# ORACLE_MCP_CACHE_SIZE=128

# Emit-gate LSP timeout (ms)
# ORACLE_LSP_TIMEOUT_MS=10000

# Skip files ignored by .gitignore when the subproject is inside a git repo
ORACLE_RESPECT_GITIGNORE=true

# Log grammar loading and per-file parse/extract failures to stderr; adds stack
# traces to CLI errors
# ORACLE_DEBUG=true

# Resource safety limits
ORACLE_MAX_FILES=100000
ORACLE_MAX_FILE_BYTES=5242880
# oracle.context keeps every result scoring >= 20% of the best match (plus
# callers of relevant code), up to this many symbols
ORACLE_CONTEXT_MAX_NODES=50
# Evidence pointers kept when a large answer is trimmed to its token cap
ORACLE_MAX_EVIDENCE=50
# Answer size caps (estimated tokens). Lists in a larger answer are shortened
# and report their full length as <field>_total. The extended cap applies to
# context, where_would, conventions_for, consumers, impact and locate.
ORACLE_TOKEN_CAP=400
ORACLE_TOKEN_CAP_EXTENDED=1500
# Max files each content-scanning contract detector (event bus, Kafka) reads
ORACLE_DETECTOR_MAX_FILES=10000
ORACLE_READ_EXACT_MAX_LINES=2000
ORACLE_READ_EXACT_MAX_BYTES=1048576
ORACLE_GATE_MAX_FILES=500
ORACLE_GATE_MAX_CODE_BYTES=5242880
ORACLE_GATE_MAX_TOTAL_CODE_BYTES=20971520
ORACLE_GATE_MAX_SHADOW_FILES=100000
ORACLE_GATE_MAX_SHADOW_BYTES=1073741824
ORACLE_GATE_USE_SHADOW=true
